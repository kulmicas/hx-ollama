#!/usr/bin/env python3
import sys
import os

# Ensure hx_ollama package can be loaded if run directly from repo or via symlink
script_dir = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.abspath(os.path.join(script_dir, "..")))

from hx_ollama.cli import main

if __name__ == "__main__":
    main()
